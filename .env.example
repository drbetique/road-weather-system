# Road Weather Monitoring System - Environment Configuration
# Copy to .env for local development. NEVER commit the real .env.

# --- API security (required in production) ---
# Shared secret required by all /api/* routes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match API_KEY in the Vercel project. If unset, /api/* returns 503.
API_KEY=

# Comma-separated allowed origins for direct browser requests.
# Format is scheme://host with no trailing path.
ALLOWED_ORIGINS=http://localhost:3000

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Single DSN from a hosted provider (Neon, Supabase, Render Postgres). This
# takes precedence over the DB_* fields below, and is what the History tab
# needs in order to accumulate data over time. sslmode=require is added
# automatically for non-local hosts.
DATABASE_URL=

# Fallback for local development, used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_weather
DB_USER=postgres
DB_PASSWORD=

# --- Data collection ---
POLLING_INTERVAL_SECONDS=300
STATION_SEARCH_RADIUS_KM=50

# --- Logging ---
LOG_LEVEL=INFO
