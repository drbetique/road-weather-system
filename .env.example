# Road Weather Monitoring System - Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_weather
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Data Collection
POLLING_INTERVAL_SECONDS=300
STATION_SEARCH_RADIUS_KM=50

# Logging
LOG_LEVEL=INFO
