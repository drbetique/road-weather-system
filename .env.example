# Road Weather Monitoring System - Environment Configuration
# Copy to .env for local development. NEVER commit the real .env.

# --- API security (required in production) ---
# Shared secret required by all /api/* routes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match API_KEY in the Vercel project. If unset, /api/* returns 503.
API_KEY=

# Comma-separated allowed origins for direct browser requests.
# Format is scheme://host with no trailing path.
ALLOWED_ORIGINS=http://localhost:3000

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (optional) ---
# Unset in the current Render free-tier deployment. With no collector running
# nothing writes to these tables, so history endpoints return mock data.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_weather
DB_USER=postgres
DB_PASSWORD=

# --- Data collection ---
POLLING_INTERVAL_SECONDS=300
STATION_SEARCH_RADIUS_KM=50

# --- Logging ---
LOG_LEVEL=INFO
